# Públicas (expuestas al cliente)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Fallback si app_settings.whatsapp_numero todavía no está seedeado
NEXT_PUBLIC_WHATSAPP_NUMBER=5491100000000

# Server-only (nunca prefijadas con NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=pedidos@groundcontrol90.com
CRON_SECRET=

# Andreani (Phase 7 — cotización, envío y tracking). Todas opcionales: si
# falta cualquiera de estas, la app funciona igual — el checkout cae al costo
# de envío plano de app_settings y el webhook simplemente no crea el envío
# (ver src/lib/andreani/client.ts). "sandbox" apunta a apisqa.andreani.com,
# "production" a apis.andreani.com.
ANDREANI_ENV=sandbox
ANDREANI_USUARIO=
ANDREANI_PASSWORD=
ANDREANI_CLIENTE_NUMERO=
ANDREANI_CONTRATO=
# Dirección de origen (depósito/local desde donde se despachan los envíos).
ANDREANI_ORIGEN_CODIGO_POSTAL=
ANDREANI_ORIGEN_CALLE=
ANDREANI_ORIGEN_NUMERO=
ANDREANI_ORIGEN_LOCALIDAD=
ANDREANI_ORIGEN_PROVINCIA=
# Identidad del remitente tal como la pide la API de creación de órdenes.
ANDREANI_REMITENTE_NOMBRE=
ANDREANI_REMITENTE_EMAIL=
ANDREANI_REMITENTE_TELEFONO=
